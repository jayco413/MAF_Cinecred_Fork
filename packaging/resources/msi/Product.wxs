<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define UpgradeCode = "d3f4499f-c56c-4f7d-b051-1f8eade3fc9c" ?>

  <Package Name="Cinecred" Version="@VERSION@" Manufacturer="@VENDOR@" UpgradeCode="$(var.UpgradeCode)" Scope="perMachineOrUser">
    <SummaryInformation Description="!(loc.Slogan)"/>
    <MediaTemplate EmbedCab="yes"/>

    <!-- Installation directory; automatically switches to %LocalAppData% for per-user installations. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Cinecred"/>
    </StandardDirectory>

    <!-- Program files -->
    <Files Include="!(bindpath.image)**" Directory="INSTALLDIR"/>
    <!-- Desktop shortcut -->
    <Property Id="DESKTOP_SHORTCUT" Value="1"/>
    <Component Condition="DESKTOP_SHORTCUT">
      <RegistryValue Root="HKMU" Key="Software\Cinecred" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
      <Shortcut Name="Cinecred" Directory="DesktopFolder" Description="!(loc.Slogan)" WorkingDirectory="INSTALLDIR" Target="[INSTALLDIR]cinecred.exe"/>
    </Component>
    <!-- Start menu shortcut -->
    <Property Id="STARTMENU_SHORTCUT" Value="1"/>
    <Component Condition="STARTMENU_SHORTCUT">
      <RegistryValue Root="HKMU" Key="Software\Cinecred" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
      <Shortcut Name="Cinecred" Directory="ProgramMenuFolder" Description="!(loc.Slogan)" WorkingDirectory="INSTALLDIR" Target="[INSTALLDIR]cinecred.exe"/>
    </Component>

    <!-- Upgrade/Downgrade -->
    <!--
      Note: We do not use <MajorUpgrade /> because that tag does not allow to schedule the removal of the previous
      installation before CostInitialize. That we in turn require to ensure that all new EXEs and DLLs are installed
      even if their metadata version does not increase in the upgrade or downgrade, which for upgrades could happen
      due to human oversight, and is the usual case for downgrades.
    -->
    <Upgrade Id="$(var.UpgradeCode)">
      <UpgradeVersion OnlyDetect="no" Property="FOUND_OLDER" Maximum="@VERSION@" IncludeMaximum="no"/>
      <UpgradeVersion OnlyDetect="no" Property="FOUND_NEWER" Minimum="@VERSION@" IncludeMinimum="no"/>
    </Upgrade>
    <InstallExecuteSequence>
      <RemoveExistingProducts Before="CostInitialize"/>
    </InstallExecuteSequence>

    <!-- Add/Remove Programs screen -->
    <Property Id="ARPNOMODIFY" Value="1"/>
    <Property Id="ARPCOMMENTS" Value="!(loc.Slogan)"/>
    <Property Id="ARPCONTACT" Value="@VENDOR@"/>
    <Property Id="ARPHELPLINK" Value="@URL@"/>
    <Property Id="ARPURLINFOABOUT" Value="@URL@"/>
    <Property Id="ARPURLUPDATEINFO" Value="@URL@"/>
    <Icon Id="CinecredIcon" SourceFile="$(var.Icon)"/>
    <Property Id="ARPPRODUCTICON" Value="CinecredIcon"/>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize"/>

    <!-- UI -->
    <UIRef Id="WixUI_Common"/>
    <UIRef Id="WixUI_ErrorProgressText"/>
    <UIRef Id="UI"/>
  </Package>
</Wix>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="ScopeDlg" Width="370" Height="270" Title="!(loc.InstallScopeDlg_Title)">
        <!-- Standard dialog elements -->
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallScopeDlgTitle)"/>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.InstallScopeDlgDescription)"/>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0"/>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)"/>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)"/>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg"/>
        </Control>

        <!-- Scope radio buttons -->
        <Control Id="Scope" Type="RadioButtonGroup" X="20" Y="55" Width="330" Height="120" Property="SCOPE">
          <RadioButtonGroup Property="SCOPE">
            <RadioButton Value="PerMachine" X="0" Y="0" Width="295" Height="16" Text="!(loc.InstallScopeDlgPerMachine)"/>
            <RadioButton Value="PerUser" X="0" Y="60" Width="295" Height="16" Text="!(loc.InstallScopeDlgPerUser)"/>
          </RadioButtonGroup>
        </Control>
        <Control Id="PerMachineDescription" Type="Text" X="33" Y="70" Width="300" Height="36" NoPrefix="yes" Text="!(loc.InstallScopeDlgPerMachineDescription)"/>
        <Control Id="PerUserDescription" Type="Text" X="33" Y="131" Width="300" Height="36" NoPrefix="yes" Text="!(loc.InstallScopeDlgPerUserDescription)"/>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
